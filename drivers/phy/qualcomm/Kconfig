config PHY_QCOM_SNPS_EUSB2
	tristate "Qualcomm SNPS eUSB2 PHY Driver"
	depends on OF && (ARCH_QCOM || COMPILE_TEST)
	select GENERIC_PHY
	help
	  Enable support for the USB high-speed SNPS eUSB2 phy on Qualcomm
	  chipsets. The PHY is paired with a Synopsys DWC3 USB controller
	  on Qualcomm SOCs. It is required for proper USB functionality on
	  platforms that integrate this PHY, such as certain Snapdragon
	  SoCs. Enable this option if you are building for a Qualcomm
	  platform that uses the SNPS eUSB2 PHY, or if you are performing
	  compile testing for PHY drivers.

config PHY_QCOM_UFS_V3
	tristate "Qualcomm Technologies, Inc. UFS PHY V3 driver"
	depends on PHY_QCOM_UFS
	help
	 Support for 11nm UFS QMP phy present on QCOM chipsets. This
	 configuration option adds support for the UFS PHY present
	 on QCOM Bengal chipsets.
	 This is required to enable UFS on Bengal chipset.
	 To compile this driver as a module, choose M here.

config PHY_QCOM_UFS_V4_KHAJE
