config PHY_QCOM_EUSB2_REPEATER
	tristate "Qualcomm eUSB2 Repeater Driver"
	depends on OF && (ARCH_QCOM || COMPILE_TEST)
	select GENERIC_PHY
	help
	  Enable support for the USB high-speed eUSB2 repeater on Qualcomm
	  PMICs. The repeater is paired with an eUSB2 Phy on Qualcomm SOCs.
	  This is required for voltage inter-operability between the eUSB2
	  phy and the DP/DM lines connecting the USB host.
	  PMICs. The repeater is paired with a eUSB2 Phy
	  on Qualcomm SOCs.

config PHY_QCOM_M31_EUSB2
	tristate "Qualcomm M31 eUSB2 PHY Driver"
	depends on OF && (ARCH_QCOM || COMPILE_TEST)
	select GENERIC_PHY
	help
	  Enable support for the USB high-speed M31 eUSB2 phy on Qualcomm
	  chipsets. The PHY is paired with a Synopsys DWC3 USB controller
	  on Qualcomm SOCs. This is required for the USB controller to
	  communicate with the USB host in High-Speed mode.

config PHY_QCOM_QMP_COMBO
	tristate "Qualcomm QMP Combo PHY Driver"
	depends on OF && COMMON_CLK && (ARCH_QCOM || COMPILE_TEST)
	depends on TYPEC || TYPEC=n
	depends on DRM || DRM=n
	select GENERIC_PHY
	select MFD_SYSCON
	help
	  Enable this to support the QMP Combo PHY transceiver that is used
	  with USB3 and DisplayPort controllers on Qualcomm chips. This is
	  required for the USB controller to communicate with the USB host
	  in Super-Speed mode.

config PHY_QCOM_SGMII_ETH
	tristate "Qualcomm DWMAC SGMII SerDes/PHY driver"
	depends on OF && (ARCH_QCOM || COMPILE_TEST)
	depends on HAS_IOMEM
	select GENERIC_PHY
	help
	  Enable this to support the Qualcomm SGMII SerDes/PHY used with the
	  DesignWare MAC Ethernet controller on Qualcomm SoCs. This is required
	  for proper SGMII link configuration between the MAC and external PHY.

config PHY_QCOM_QMP_USB
	tristate "Qualcomm QMP USB PHY Driver"
	select GENERIC_PHY
	default PHY_QCOM_QMP
	help
	  Enable this to support the QMP USB PHY transceiver that is used
	  with USB3 controllers on Qualcomm chips.

config PHY_QCOM_UFS_V4_GLYMUR
	tristate "Qualcomm Technologies, Inc. UFS Glymur Phy Driver"
	depends on PHY_QCOM_UFS
	help
	  Enable support for the Qualcomm UFS QMP v4 PHY found on
	  Glymur-based platforms. This driver initializes and manages
	  the UFS PHY used by the UFS controller during link startup and
	  normal operation.
	  Select this option if the target platform uses the Glymur
	  UFS PHY. To build this driver as a module, choose M here.
